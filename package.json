{
  "name": "agent-admin",
  "version": "2.0.10",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --mode dev",
    "dev:cqa": "vite --mode cqa",
    "dev:prod": "vite --mode prod",
    "build:dev": "pnpm run type-check && pnpm run build-only --mode dev",
    "build:cqa": "pnpm run type-check && pnpm run build-only --mode cqa",
    "build:prod": "pnpm run type-check && pnpm run build-only --mode prod",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "preview": "vite preview",
    "preinstall": "npx only-allow pnpm",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "twcn:check": "node scripts/convert-twtocn.mjs check",
    "twcn:convert": "node scripts/convert-twtocn.mjs convert"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vueuse/core": "^14.0.0",
    "@vueuse/integrations": "^14.0.0",
    "axios": "^1.13.1",
    "big.js": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "embla-carousel-vue": "^8.6.0",
    "lucide-vue-next": "^0.553.0",
    "merge-images": "^2.0.0",
    "pinia": "^3.0.3",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.6.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "vant": "^4.9.21",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.0.4",
    "@tsconfig/node22": "^22.0.2",
    "@types/merge-images": "^1.2.4",
    "@types/node": "^22.18.6",
    "@vant/auto-import-resolver": "^1.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.33.0",
    "eslint-plugin-oxlint": "~1.11.0",
    "eslint-plugin-vue": "~10.4.0",
    "jiti": "^2.5.1",
    "npm-run-all2": "^8.0.4",
    "opencc-js": "^1.0.5",
    "oxlint": "~1.11.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "sass-embedded": "^1.93.3",
    "typescript": "~5.9.0",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^29.1.0",
    "vite": "^7.1.7",
    "vite-plugin-vue-devtools": "^8.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vue-tsc": "^3.1.0"
  },
  "packageManager": "pnpm@10.22.0"
}
